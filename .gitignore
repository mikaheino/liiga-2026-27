# FULL-BACKUP POLICY (2026-08-18)
# This repo is a complete backup of the project: if the local machine dies, a
# clone + `pip install -e .` restores everything. So we track things a normal
# repo would not -- the built DuckDB, the raw API cache, and logs.
#
# Only genuinely MACHINE-REGENERABLE artifacts are excluded below. Nothing here
# represents lost work: every entry is rebuilt automatically by the toolchain,
# and most of it is platform-specific so it would not survive a move anyway.

# Virtualenv -- restore with:  python -m venv .venv && pip install -e .
# (631 MB of platform-specific compiled binaries; useless on another machine.)
.venv/
venv/

# Python build/bytecode caches -- regenerated on import/install.
# Committing stale .pyc files actively causes hard-to-debug import bugs.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Jupyter checkpoint copies
.ipynb_checkpoints/

# Secrets -- must never be committed
.env

# macOS Finder metadata
.DS_Store

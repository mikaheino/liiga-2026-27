#!/bin/bash
# Sama laatuportti kuin CI:ssä (.github/workflows/ci.yml) ennen pushia.
# Käyttöön: git config core.hooksPath .githooks   (kerran per kloonattu repo)
# Ohitus hätätilassa: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
PY=.venv/bin/python
[ -x "$PY" ] || PY=python3
echo "pre-push: koodin laatu (scripts/dev/quality.py)"
"$PY" scripts/dev/quality.py
